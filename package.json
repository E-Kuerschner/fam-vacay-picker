{
	"name": "fam-vacay-picker",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"dev": "react-router dev",
		"preview": "bun build && vite preview",
		"deploy": "bun run build && wrangler deploy",
		"postinstall": "bun cf-typegen",
		"typecheck": "bun cf-typegen && react-router typegen && tsc -b",
		"db:generate": "bun x @better-auth/cli generate --yes --output ./database/authSchema.ts && bun --bun --env-file=.dev.vars drizzle-kit --config database/drizzle.config.ts generate",
		"db:migrate": "bun --bun --env-file=.dev.vars drizzle-kit --config database/drizzle.config.ts migrate",
		"db:migrate:local": "wrangler d1 migrations apply fam-vacay-picker --local",
		"db:reset:local": "rm -rf .wrangler/state/v3/d1 && bun run db:migrate:local"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.71.2",
		"@coinbase/cds-web": "^8.34.1",
		"@googlemaps/js-api-loader": "^2.0.2",
		"better-auth": "^1.4.10",
		"drizzle-orm": "^0.45.1",
		"framer-motion": "^10",
		"isbot": "^5.1.31",
		"react": "^18",
		"react-dom": "^18",
		"react-router": "^7.10.0",
		"resend": "^6.6.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.13.5",
		"@react-router/dev": "^7.10.0",
		"@types/bun": "^1.3.5",
		"@types/google.maps": "^3.58.1",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"drizzle-kit": "^0.31.8",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vite-tsconfig-paths": "^5.1.4",
		"wrangler": "^4.54.0"
	}
}